<aura:component implements="forceCommunity:availableForAllPageTypes,force:hasRecordId"
                access="global">

    <aura:attribute name="caseRecord" type="Object"/>
    <aura:attribute name="recordError" type="String"/>

    <aura:attribute name="titleColor" type="String" default="#001535"/>
    <aura:attribute name="bannerBackground" type="String" default="#f3f3f3"/>

    <force:recordData aura:id="recordLoader"
        recordId="{!v.recordId}"
        fields="CaseNumber,Subject,Status,CreatedDate"
        targetFields="{!v.caseRecord}"
        targetError="{!v.recordError}"
    />

    <div class="slds-box custom-wrapper">

        <!-- Meta -->
        <div class="case-meta">
            Requête numéro {!v.caseRecord.CaseNumber}
        </div>

        <!-- Titre -->
        <aura:html tag="h1"
                   HTMLAttributes="{ 'class': 'case-title', 'style': 'color:' + v.titleColor }">
            {!v.caseRecord.Subject}
        </aura:html>

        <!-- Bannière infos -->
        <aura:html tag="div"
                   HTMLAttributes="{ 'class': 'info-banner', 'style': 'background-color:' + v.bannerBackground }">

            <div class="info-group">
                <div class="info-column">
                    <span class="info-label">Ouvert</span>
                    <span class="info-value">
                        <lightning:formattedDateTime
                            value="{!v.caseRecord.CreatedDate}"
                            year="numeric"
                            month="numeric"
                            day="numeric"/>
                    </span>
                </div>

                <div class="info-column separator">
                    <span class="info-label">Statut</span>
                    <span class="info-value">{!v.caseRecord.Status}</span>
                </div>
            </div>

            <!-- Action -->
            <aura:if isTrue="{!v.caseRecord.Status == 'Closed'}">
                <button class="slds-button btn-custom-outline">
                    Rouvrir
                </button>
            </aura:if>

        </aura:html>

        <!-- Navigation bas -->
        <div class="tab-navigation">
            <div class="active-tab">
                Détails
            </div>
        </div>

    </div>
</aura:component>
