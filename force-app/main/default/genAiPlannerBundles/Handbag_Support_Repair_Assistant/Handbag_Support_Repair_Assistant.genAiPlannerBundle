    <localTopics>
        <fullName>Create_Support_Cases_16jAW0000003GTF</fullName>
        <canEscalate>false</canEscalate>
        <description>Handle customer requests related to reporting issues, opening support cases, or addressing problems with orders such as incorrect items or damaged products.</description>
        <developerName>Create_Support_Cases_16jAW0000003GTF</developerName>
        <genAiPluginInstructions>
            <description>Ask the customer for detailed information about the issue they are experiencing.</description>
            <developerName>instruction_1</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 1</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Always collect the user&apos;s email (Var_email) and a clear description of the handbag problem (VarDescription) before attempting to trigger any case creation action.</description>
            <developerName>instruction_2</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 2</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>When a customer reports a product defect or requests a return, you MUST immediately collect their email and a problem description, then trigger the &apos;Create Case With Agentforce&apos; action. Do not offer alternatives; case creation is the mandatory next step.</description>
            <developerName>instruction_3</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 3</masterLabel>
            <sortOrder>2</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Once you have the email and description, do not wait for further confirmation. Immediately execute the &apos;Create Case With Agentforce&apos; action to ensure the request is logged in Salesforce.</description>
            <developerName>instruction_4</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 4</masterLabel>
            <sortOrder>3</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>After the action is triggered, inform the customer that their case has been successfully created and provide the &apos;Loading...&apos; feedback while the system processes.</description>
            <developerName>instruction_5</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 5</masterLabel>
            <sortOrder>4</sortOrder>
        </genAiPluginInstructions>
